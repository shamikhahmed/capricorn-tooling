{
  "name": "capricorn-tooling",
  "version": "1.0.0",
  "description": "Cross-repo tooling for Capricorn Systems \u2014 marketing pipeline, design system sync, agent orchestration.",
  "private": true,
  "type": "module",
  "scripts": {
    "release:marketing": "node scripts/release-marketing.mjs",
    "sync:versions": "node scripts/sync-versions.mjs",
    "sync:catalog": "node scripts/sync-catalog-versions.mjs",
    "sync:design-system": "node scripts/sync-design-system.mjs",
    "build:tokens": "node scripts/build-design-tokens.mjs",
    "audit:tokens": "node scripts/audit-design-tokens.mjs",
    "audit:truth": "node scripts/truth-audit.mjs",
    "audit:versions": "node scripts/audit-version-truth.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "contrast:check": "node scripts/contrast-check.mjs",
    "tier1": "node shared/testing/tier1.mjs",
    "test:tier1": "node --test shared/testing/__tests__/tier1.test.mjs",
    "architecture:analyze": "node shared/architecture/analyze.mjs",
    "architecture:test": "node --test shared/architecture/__tests__/architecture.test.mjs shared/architecture/__tests__/adapters.test.mjs shared/architecture/__tests__/pages-unpublished.test.mjs",
    "architecture:viewer": "node shared/architecture/prepare-viewer.mjs",
    "architecture:viewer:stress": "node shared/architecture/prepare-viewer.mjs --stress 5000",
    "architecture:pages-404": "node scripts/verify-architecture-unpublished.mjs",
    "test": "node --test shared/testing/__tests__/tier1.test.mjs shared/architecture/__tests__/architecture.test.mjs shared/architecture/__tests__/adapters.test.mjs shared/architecture/__tests__/pages-unpublished.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shamikhahmed/capricorn-tooling.git"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
